# Azure AI Services / Foundry endpoint
# Format: https://<resource-name>.openai.azure.com/  or  https://<resource-name>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# Model deployment name (created by azd up or manually)
# gpt-realtime-2 uses the GA endpoint: /openai/v1/realtime?model={deployment}
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-2

# Auth: DefaultAzureCredential (az login / Managed Identity)
# API Key 인증은 보안 정책에 의해 비활성화됨 (disableLocalAuth: true)
